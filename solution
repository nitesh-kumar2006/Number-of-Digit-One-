class Solution {
    public int countDigitOne(int n) {
        int count = 0;

        for (long i = 1; i <= n; i = i * 10) {
            long divisor = i * 10;
            count += (n / divisor) * i;
            long remainder = n % divisor;
            count += Math.min(Math.max(remainder - i + 1, 0), i);
        }
        return count;
    }
}
